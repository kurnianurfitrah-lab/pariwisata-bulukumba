NODE_ENV=development
PORT=5000
TRUST_PROXY=1
FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bulukumba_tourism_db
DB_CONNECTION_LIMIT=10

# Gunakan secret acak minimal 32 karakter di production:
# openssl rand -hex 64
JWT_SECRET=dev_secret_change_me
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=bulukumba_admin_session

# Di production, arahkan ke direktori persisten di luar repository.
UPLOAD_DIR=./uploads-bulukumba-wisata

# Development boleh menjalankan migrasi otomatis. Production wajib menjalankan
# `npm run migrate` secara eksplisit dan memakai false.
RUN_MIGRATIONS_ON_STARTUP=true

# Aktifkan hanya pada bootstrap pertama, kemudian ubah kembali menjadi false.
SEED_ADMIN_ON_STARTUP=false
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
